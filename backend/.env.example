# Copy to .env and adjust for your machine.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml. Tests use .env.test, which points at autotrust_test.
DATABASE_URL=postgresql://autotrust:autotrust@localhost:5432/autotrust

# REQUIRED: signs login tokens. Generate your own unique random value (at least 32 characters);
# never reuse an example or shared value. The server refuses to start while this is empty.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Only used by `npm run db:seed` (creates/promotes this admin account).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-password
