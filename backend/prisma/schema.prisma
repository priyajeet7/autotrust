// AutoTrust database schema.
// Connection URL lives in prisma.config.ts (Prisma 7); the app connects via the pg driver adapter.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VehicleCategory {
  SEDAN
  SUV
  TRUCK
  COUPE
  HATCHBACK
  CONVERTIBLE
  VAN
  WAGON
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]

  @@map("users")
}

model Vehicle {
  id        String          @id @default(uuid()) @db.Uuid
  make      String
  model     String
  year      Int
  category  VehicleCategory
  price     Decimal         @db.Decimal(12, 2)
  quantity  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  purchases Purchase[]

  @@index([make])
  @@index([model])
  @@index([category])
  @@index([price])
  @@map("vehicles")
}

/// A completed sale. Rows outlive the vehicle (vehicleId becomes null) so sales history is kept;
/// unitPrice is captured at purchase time because a vehicle's price can change later.
model Purchase {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  vehicleId String?  @db.Uuid
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([vehicleId])
  @@map("purchases")
}
