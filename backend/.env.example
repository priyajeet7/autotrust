# Copy to .env and adjust for your machine.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml. Tests use .env.test, which points at autotrust_test.
DATABASE_URL=postgresql://autotrust:autotrust@localhost:5432/autotrust

# Signs login tokens. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
